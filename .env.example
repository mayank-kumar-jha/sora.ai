PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/super_ai_assistant
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
NODE_ENV=development
BCRYPT_SALT_ROUNDS=12
# Required for the Assistant to respond and generate text
OPENAI_API_KEY=your.key

# Required for RAG (Long-term Memory) and semantic search
VECTOR_DB_API_KEY=your_pinecone_or_qdrant_api_key
VECTOR_DB_INDEX=your_vector_index_name
